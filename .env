# ─────────────────────────────────────────────────────────────────────
# Real-Time Fraud Detection System — Environment Configuration
# Copy this to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database: SQLite (default, zero setup) — set USE_SQLITE=false to switch to MySQL
USE_SQLITE=true
SQLITE_PATH=fraud_detection.db

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=fraud_detection

# ML
FRAUD_THRESHOLD=0.5
HIGH_RISK_SCORE=70

# Simulation
SIMULATION_INTERVAL=2.0
SIMULATION_FRAUD_RATE=0.15
